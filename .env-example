# Copy to .env and fill in (never commit .env)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional overrides
BOOKGEN_CONFIG=config/book.json
BOOKGEN_LOG_LEVEL=INFO
# Model ids (provider picked by which key is set: anthropic > openai > google)
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.1-flash-lite
# Max OUTPUT tokens per Anthropic response (ceiling, not a purchase; too low
# truncates the book JSON mid-response and the run fails)
ANTHROPIC_MAX_TOKENS=64000
