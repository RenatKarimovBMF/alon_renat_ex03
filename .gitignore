# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Secrets
.env
*.pem
*.key
credentials.json

# LaTeX build artifacts (keep build/README.md + book.pdf for graders)
latex/build/*
!latex/build/README.md
!latex/build/book.pdf
latex/main.pdf
latex/**/*.aux
latex/**/*.log
latex/**/*.out
latex/**/*.toc
latex/**/*.bbl
latex/**/*.blg
latex/**/*.fls
latex/**/*.fdb_latexmk
latex/**/*.synctex.gz

# Session outputs — keep one sample run committed as submission evidence
data/sessions/*
!data/sessions/sample/
!data/sessions/sample/**
logs/

# Live-run example folders: keep the PDF, chapters, session JSON, and cost
# evidence; skip the staged figure copies (duplicates of assets/) and aux files
examples/*/latex/figures/
examples/*/latex/build/*
!examples/*/latex/build/book.pdf
examples/*/logs/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
